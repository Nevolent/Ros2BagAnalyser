#!/usr/bin/env python3
"""Provision and smoke-test the candidate's model before deployment interrupts services."""
import os
from pathlib import Path
import subprocess
import sys

from deploy_release import private_environment
from rosbag_analyser.model_runtime import default_runtime_root, validate_runtime
from rosbag_analyser.model_setup import provision


def main():
    if os.getuid() != 0 or len(sys.argv) != 2:
        raise SystemExit("Run with the candidate release Python as root, passing its release directory.")
    release = Path(sys.argv[1])
    if release.is_symlink() or release.resolve().parent != Path("/opt/rosbag-analyser/releases"):
        raise SystemExit("The candidate must be a contained immutable release.")
    settings = private_environment(Path("/etc/rosbag-analyser/application.env"))
    root = Path(settings.get("ROS_BAG_ANALYSER_DESCRIPTION_RUNTIME_ROOT") or default_runtime_root(deployment=True))
    if root.parent != Path("/opt/rosbag-analyser/models"):
        raise SystemExit("Deployment model storage must be directly below /opt/rosbag-analyser/models.")
    provision(root, Path("/opt/rosbag-analyser/staging/model-downloads"))
    validate_runtime(root, verify_hashes=True)
    # The service identity must be able to load the native runtime and weights.
    subprocess.run(["runuser", "-u", "rosbag-analyser", "--", str(release / "venv/bin/python"),
                    "-m", "rosbag_analyser.model_setup", "smoke", "--runtime-root", str(root),
                    "--threads", settings.get("ROS_BAG_ANALYSER_DESCRIPTION_THREADS", "4")],
                   check=True, timeout=330)


if __name__ == "__main__":
    main()
