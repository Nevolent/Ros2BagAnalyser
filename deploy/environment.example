# Placeholder-only systemd EnvironmentFile. Install as
# /etc/rosbag-analyser/application.env, owned by root:rosbag-analyser, mode 0640.
ROS_BAG_ANALYSER_DEPLOYMENT_MODE=1
ROS_BAG_ANALYSER_RELEASE_ID=REPLACE_WITH_REVIEWED_RELEASE_ID
ROS_BAG_ANALYSER_ARCHIVE_ROOT=/srv/rosbag-analyser/source
ROS_BAG_ANALYSER_DERIVED_ROOT=/var/lib/rosbag-analyser/derived
ROS_BAG_ANALYSER_DATABASE_URL=postgresql://rosbag_analyser_runtime@/rosbag_analyser?host=/run/postgresql
ROS_BAG_ANALYSER_FRONT_TOPIC=/kuupkulgur_v1/sensors/front_camera/image_raw
ROS_BAG_ANALYSER_IMU_TOPIC=/kuupkulgur_v1/sensors/imu0/raw_data
ROS_BAG_ANALYSER_IMU_COMPONENT=angular_velocity.z
ROS_BAG_ANALYSER_PREVIEW_PROFILE=h264-720p-v1
ROS_BAG_ANALYSER_FFMPEG=/usr/bin/ffmpeg
ROS_BAG_ANALYSER_FFPROBE=/usr/bin/ffprobe
ROS_BAG_ANALYSER_BIND_HOST=127.0.0.1
ROS_BAG_ANALYSER_BIND_PORT=8000
ROS_BAG_ANALYSER_SOURCE_MOUNT_FSTYPE=cifs
ROS_BAG_ANALYSER_SOURCE_MOUNT_SOURCE=//nas.example.invalid/TO_Rosbag_databank
ROS_BAG_ANALYSER_SOURCE_MOUNT_ROOT=/
ROS_BAG_ANALYSER_DERIVED_MOUNT_FSTYPE=cifs
ROS_BAG_ANALYSER_DERIVED_MOUNT_SOURCE=//nas.example.invalid/TO_Rosbag_databank/Rosbag_Analyser_Cache
ROS_BAG_ANALYSER_DERIVED_MOUNT_ROOT=/
ROS_BAG_ANALYSER_DERIVED_MIN_FREE_BYTES=REPLACE_WITH_MEASURED_THRESHOLD
ROS_BAG_ANALYSER_DERIVED_MIN_FREE_PERCENT=10
ROS_BAG_ANALYSER_CATALOG_MAX_DEPTH=8
ROS_BAG_ANALYSER_CATALOG_MAX_ENTRIES=100000
ROS_BAG_ANALYSER_CATALOG_MAX_DIRECTORIES=10000
ROS_BAG_ANALYSER_CATALOG_MAX_RECORDINGS=5000
ROS_BAG_ANALYSER_CATALOG_MAX_DIRECTORY_ENTRIES=2000
ROS_BAG_ANALYSER_CATALOG_MAX_RECORDING_ENTRIES=256
ROS_BAG_ANALYSER_PREPARE_MAX_RECORDINGS=100
