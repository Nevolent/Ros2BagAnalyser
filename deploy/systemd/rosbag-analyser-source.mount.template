[Unit]
Description=ROS Bag Analyser fixed read-only source export
Documentation=file:/opt/rosbag-analyser/current/docs/NAS_TRIAL_RUNBOOK.md
Wants=network-online.target
After=network-online.target
Before=rosbag-analyser-preflight.service rosbag-analyser-api.service rosbag-analyser-worker.service

[Mount]
What=nas.example.invalid:/REPLACE_WITH_FIXED_EXPORT
Where=/srv/rosbag-analyser/source
Type=nfs4
Options=ro,nosuid,nodev,noexec,_netdev,vers=4.2
TimeoutSec=60

[Install]
WantedBy=multi-user.target
