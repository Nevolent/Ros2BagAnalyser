[Unit]
Description=ROS Bag Analyser writable SMB cache folder
Documentation=file:/opt/rosbag-analyser/current/docs/NAS_TRIAL_RUNBOOK.md
Wants=network-online.target
After=network-online.target
Before=rosbag-analyser-preflight.service rosbag-analyser-api.service rosbag-analyser-worker.service

[Mount]
What=//nas.example.invalid/TO_Rosbag_databank/Rosbag_Analyser_Cache
Where=/var/lib/rosbag-analyser/derived
Type=cifs
Options=rw,nosuid,nodev,noexec,_netdev,vers=3.1.1,credentials=/etc/rosbag-analyser/source.cifs-credentials,uid=rosbag-analyser,gid=rosbag-analyser,forceuid,forcegid,file_mode=0640,dir_mode=0750
TimeoutSec=60

[Install]
WantedBy=multi-user.target
