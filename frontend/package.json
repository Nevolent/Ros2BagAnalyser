{
  "name": "tectrace-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src docs README.md index.html vite.config.ts playwright.config.ts tsconfig.json scripts/visual-regression.mjs tests",
    "format:check": "prettier --check src docs README.md index.html vite.config.ts playwright.config.ts tsconfig.json scripts/visual-regression.mjs tests",
    "visual:capture": "node scripts/visual-regression.mjs baseline",
    "visual:compare": "node scripts/visual-regression.mjs compare"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
